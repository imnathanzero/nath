rm -rf external/wpa_supplicant_8;git clone https://github.com/nathanzerogarage/android_external_wpa_supplicant_8.git -b lineage-23.2 external/wpa_supplicant_8

rm -rf out/target

. build/env*

export BUILD_USERNAME=nathan
export TZ=Asia/Jakarta

brunch tanzanite userdebug
